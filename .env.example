# ============================================================
# web-audit — пример переменных окружения
# ============================================================
#
# Копируйте в .env.local (не коммитится) и заполняйте.
# Реальные секреты в production задаются так:
#   - для Worker: `wrangler secret put GEMINI_API_KEY`
#   - для GitHub Pages: через GitHub Actions Secrets (если нужно)
# ============================================================

# --- Worker (Cloudflare) ---
# API-ключ Google Gemini для генерации аудита.
# Получить: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Web (Vite) ---
# URL развёрнутого Worker'а. Используется фронтендом для запросов /api/*.
# В разработке: http://localhost:8787
# В production: https://web-audit.<ваш-subdomain>.workers.dev
VITE_API_URL="http://localhost:8787"