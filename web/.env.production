# Переменные окружения для production-сборки (npm run build).
# Vite автоматически подхватывает .env.production при сборке.
#
# VITE_API_URL — адрес развёрнутого Cloudflare Worker, куда фронт
# отправляет запросы /api/audit. Значение подставляется в App.tsx
# через import.meta.env.VITE_API_URL на этапе сборки.
VITE_API_URL="https://web-audit.my-scrapers-app.workers.dev"