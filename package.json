{
  "name": "web-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express web page audit & Core Web Vitals (Mobile & Desktop)",
  "workspaces": [
    "web",
    "worker",
    "bot"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:worker": "npm run dev --workspace=worker",
    "dev:bot": "npm run dev --workspace=bot",
    "build:web": "npm run build --workspace=web",
    "deploy:worker": "npm run deploy --workspace=worker",
    "deploy:bot": "npm run deploy --workspace=bot",
    "lint": "npm run lint --workspace=web && npm run lint --workspace=worker && npm run lint --workspace=bot"
  },
  "allowScripts": {
    "workerd@1.20261001.1": true,
    "esbuild@0.28.1": true
  }
}
